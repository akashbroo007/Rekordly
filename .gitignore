# Environment variables
.env

# Dependencies
node_modules/

# Uploads and recordings
uploads/
recordings/
downloads/
*.mp4
*.webm
*.mov
*.mkv

# Database
data/
*.sqlite
*.db

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
*.swp
*.swo
.history/

# Build output
dist/
out/
release/

# Electron build resources are tracked (icon), ignore nothing there
!apps/desktop/build/**

# Vendored external binaries (yt-dlp/ffmpeg) — fetched at build time via
# `pwsh ./scripts/fetch-binaries.ps1`, never committed (ffmpeg >100 MB).
apps/desktop/resources/binaries/*.exe

# Old/backup files
*.old
*.backup
